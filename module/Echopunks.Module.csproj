<Project Sdk="Microsoft.NET.Sdk">

  <!-- The RELOADABLE half of the mod: every feature (announcers, localization, input, UI graph)
       lives here. The host (Echopunks.dll, ../Echopunks.csproj) byte-loads this dll via
       Modularity/ModuleLoader, so the file is never locked — rebuild with the game running, then
       POST /reload (or F6 in a Debug build) hot-swaps the features without a game restart or
       another trip through the boot click-gate. See src/Modularity/IModModule.cs for the rules. -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Echopunks.Module</AssemblyName>
    <RootNamespace>Echopunks</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\EXAPUNKS</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host: shared statics (Log, GameState, Tts, MemberResolver) and the module contract.
         Private=false — the host deploys itself; we ship only Echopunks.Module.dll from here. -->
    <ProjectReference Include="..\Echopunks.csproj" Private="false" />
    <!-- Module-owned Harmony patches (per-load unique id + UnpatchSelf — see IModModule). -->
    <Reference Include="0Harmony">
      <HintPath>..\third_party\harmony\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- THE GAME, typed: the local de4dot output (readable names; assembly name "Burbank", same as
         shipping, so the reference binds to the loaded game at runtime). The host's load-time
         remapper rewrites our deob-name references to the shipping obfuscated names via the
         namemap.tsv generated below. BUILD PREREQUISITE: game/EXAPUNKS-deob.exe must exist locally
         (never committed, never shipped — see CLAUDE.md "Analysis workspace"). -->
    <Reference Include="EXAPUNKS-deob">
      <HintPath>..\game\EXAPUNKS-deob.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The game's own Steamworks wrapper (unobfuscated, next to the deob exe; binds to the
         game's loaded copy at runtime): the opponent home host's plate shows the Steam persona
         in multiplayer battles. -->
    <Reference Include="Steamworks.NET">
      <HintPath>..\game\Steamworks.NET.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- In-box framework assembly (nothing shipped): locale JSON parsing. -->
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <!-- The orig copy is just bytes from the installed game — fetch it automatically. -->
  <Target Name="EnsureOrigExe" BeforeTargets="CheckDeobExists"
          Condition="!Exists('..\game\EXAPUNKS.orig.exe') And Exists('$(GameDir)\EXAPUNKS.exe')">
    <MakeDir Directories="..\game" />
    <Copy SourceFiles="$(GameDir)\EXAPUNKS.exe" DestinationFiles="..\game\EXAPUNKS.orig.exe" />
    <Message Importance="high" Text="Copied game\EXAPUNKS.orig.exe from $(GameDir)" />
  </Target>

  <Target Name="CheckDeobExists" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('..\game\EXAPUNKS-deob.exe') Or !Exists('..\game\EXAPUNKS.orig.exe')"
           Text="game/EXAPUNKS-deob.exe is required to build the module (typed game access — see CLAUDE.md). One-time setup: run tools\prepare-game.ps1 (needs the game installed; de4dot is vendored)." />
  </Target>

  <!-- The deob → shipping rename table the host applies at module load. Regenerated only when the
       game binaries change; deployed next to the locale files. -->
  <Target Name="GenerateNameMap" AfterTargets="Build"
          Inputs="..\game\EXAPUNKS.orig.exe;..\game\EXAPUNKS-deob.exe"
          Outputs="$(IntermediateOutputPath)namemap.tsv">
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\..\tools\NameMap&quot; -- &quot;$(MSBuildProjectDirectory)\..\game\EXAPUNKS.orig.exe&quot; &quot;$(MSBuildProjectDirectory)\..\game\EXAPUNKS-deob.exe&quot; &quot;$(IntermediateOutputPath)namemap.tsv&quot;" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Echopunks.Tests" />
  </ItemGroup>

  <!-- Byte-loaded means never file-locked: this copy succeeds even while the game is running.
       That IS the hot-reload loop — build, then /reload. -->
  <Target Name="DeployModule" AfterTargets="GenerateNameMap" Condition="'$(Configuration)' == 'Debug'">
    <Copy SourceFiles="$(OutputPath)Echopunks.Module.dll" DestinationFolder="$(GameDir)" />
    <Copy SourceFiles="$(IntermediateOutputPath)namemap.tsv" DestinationFolder="$(GameDir)\Echopunks" />
    <!-- Locale tables land under <game>\Echopunks\locale\<lang>\*.json (the module is byte-loaded
         and has no disk location, so LocalizationManager roots off the host dll's folder). A module
         hot-reload re-reads them: edit a string, build, /reload, hear it. -->
    <ItemGroup>
      <LocaleFiles Include="$(MSBuildProjectDirectory)\assets\locale\**\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(LocaleFiles)"
          DestinationFiles="@(LocaleFiles->'$(GameDir)\Echopunks\locale\%(RecursiveDir)%(Filename)%(Extension)')" />
    <!-- The zine documents (repo docs/game/*.html + images/): TRASH WORLD NEWS's Digital Version
         buttons shell-open these from <game>\Echopunks\docs\ instead of the game's text-locked
         PDFs (Screens/TrashWorldNewsScreen.cs). -->
    <ItemGroup>
      <DocFiles Include="$(MSBuildProjectDirectory)\..\docs\game\*.html" />
      <DocImages Include="$(MSBuildProjectDirectory)\..\docs\game\images\*" />
    </ItemGroup>
    <Copy SourceFiles="@(DocFiles)" DestinationFolder="$(GameDir)\Echopunks\docs" />
    <Copy SourceFiles="@(DocImages)" DestinationFolder="$(GameDir)\Echopunks\docs\images" />
    <Message Importance="high" Text="Echopunks.Module + locale + docs deployed to $(GameDir)" />
  </Target>

</Project>
